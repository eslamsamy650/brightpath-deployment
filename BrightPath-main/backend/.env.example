# Backend environment settings for BrightPath
# Copy this file to backend/.env and replace placeholder values.

# Required values
FRONTEND_URL=http://localhost:5173

# PostgreSQL connection string
# Local Docker: docker compose up -d postgres
DATABASE_URL=postgresql://brightpath:brightpath@127.0.0.1:5433/brightpath?schema=public

# Neon pooler example (add for Prisma):
# DATABASE_URL=postgresql://USER:PASS@HOST/neondb?sslmode=require&pgbouncer=true&connection_limit=1

# Generate dev secrets: node ../scripts/generate-dev-env.mjs
JWT_ACCESS_SECRET=your-long-access-secret-at-least-32-characters
JWT_REFRESH_SECRET=your-long-refresh-secret-at-least-32-characters

# Optional values with defaults
# NODE_ENV=development
# PORT=5000
# API_PREFIX=/api/v1
# JWT_ACCESS_EXPIRES_IN=15m
# JWT_REFRESH_EXPIRES_IN=7d
# BCRYPT_ROUNDS=12
# UPLOAD_DIR=uploads
# MAX_FILE_SIZE_MB=10

# SMTP and email defaults
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=
# SMTP_PASS=
# EMAIL_FROM="BrightPath School <no-reply@brightpath.eg>"

# Other optional payment/SMS configs can remain blank unless used
# VODAFONE_SMS_API_URL=
# VODAFONE_SMS_USERNAME=
# VODAFONE_SMS_PASSWORD=
# VODAFONE_SMS_SENDER=BrightPath
# FAWRY_API_URL=
# FAWRY_MERCHANT_CODE=
# FAWRY_SECURITY_KEY=
# FAWRY_SANDBOX=true
# PAYMOB_API_KEY=
# PAYMOB_INTEGRATION_ID=
# PAYMOB_IFRAME_ID=

# Logging
# RATE_LIMIT_WINDOW_MS=900000
# RATE_LIMIT_MAX_REQUESTS=100
# LOG_LEVEL=debug
# LOG_DIR=logs
