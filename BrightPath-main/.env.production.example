# BrightPath production environment — copy to .env.production and fill real values.
# Usage: docker compose -f docker-compose.prod.yml --env-file .env.production up -d

# --- PostgreSQL ---
POSTGRES_USER=brightpath
POSTGRES_PASSWORD=change-me-strong-password
POSTGRES_DB=brightpath

# --- Backend API ---
NODE_ENV=production
PORT=4000
API_PREFIX=/api/v1
BACKEND_PORT=4000
FRONTEND_URL=https://school.example.com
DATABASE_URL=postgresql://brightpath:change-me-strong-password@postgres:5432/brightpath?schema=public

# JWT (min 32 characters each — generate with: openssl rand -base64 48)
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Security / uploads
BCRYPT_ROUNDS=12
UPLOAD_DIR=uploads
MAX_FILE_SIZE_MB=10

# Email (optional)
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=BrightPath School <no-reply@brightpath.eg>

# Rate limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# Logging
LOG_LEVEL=info
LOG_DIR=logs

# --- Frontend (build-time + runtime) ---
FRONTEND_PORT=80
# Relative path works when nginx proxies /api to backend
VITE_API_BASE=/api/v1

# --- Backup script (scripts/backup-postgres.sh) ---
BACKUP_DIR=./backups
RETENTION_DAYS=7
